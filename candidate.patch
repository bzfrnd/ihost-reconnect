name: Build iHost Reconnect

on:
  workflow_dispatch:

permissions:
  contents: read
  packages: write

env:
  IMAGE_NAME: ihost-reconnect

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # ============================================================
      # CHECKOUT
      # ============================================================

      - name: Checkout repository
        uses: actions/checkout@v4


      # ============================================================
      # FETCH OFFICIAL EWELINK iHOST ADD-ON
      # ============================================================

      - name: Fetch pinned upstream
        shell: bash
        run: |
          set -euo pipefail

          git init source

          git -C source remote add origin \
            https://github.com/eWeLinkCUBE/cc.ewelink.smart.home.addon.git

          git -C source fetch \
            --depth 1 \
            origin c66a0151e70363131715cbcec69430f442fb009a

          git -C source checkout --detach FETCH_HEAD

          echo "Upstream checked out successfully."


      # ============================================================
      # APPLY OUR PATCH
      # ============================================================

      - name: Apply reconnect and OAuth patch
        shell: bash
        run: |
          set -euo pipefail

          cd source

          git apply --check ../candidate.patch
          git apply ../candidate.patch

          echo "candidate.patch successfully applied."


      # ============================================================
      # CREATE iHOST-COMPATIBLE DOCKERFILE
      #
      # The patch already contains Dockerfile.candidate,
      # but we deliberately overwrite it here so the complete
      # iHost build definition lives in this single workflow.
      # ============================================================

      - name: Create iHost Dockerfile
        shell: bash
        run: |
          set -euo pipefail

          cat > source/Dockerfile.candidate <<'DOCKERFILE'
          # ========================================================
          # BUILD STAGE
          # ========================================================

          FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS build

          WORKDIR /build

          # --------------------------------------------------------
          # Server
          # --------------------------------------------------------

          COPY server/package*.json ./server/

          RUN cd server \
              && npm install \
                  --ignore-scripts \
                  --no-audit \
                  --no-fund \
              && npm install \
                  --no-save \
                  --ignore-scripts \
                  @types/ws@7

          COPY server ./server

          RUN cd server && npm run build


          # --------------------------------------------------------
          # Web UI
          # --------------------------------------------------------

          COPY web/package*.json ./web/

          RUN cd web \
              && npm ci \
                  --ignore-scripts \
                  --no-audit \
                  --no-fund

          COPY web ./web
          COPY version ./version

          RUN cd web \
              && VITE_VERSION=$(cat ../version) npm run build-only \
              && npm run type-check


          # ========================================================
          # RUNTIME STAGE
          #
          # Buildx target:
          # linux/arm/v7
          #
          # This is the architecture required by iHost.
          # ========================================================

          FROM node:22-bookworm-slim

          ENV NODE_ENV=production
          ENV APP_ENV=prod

          WORKDIR /workspace


          # --------------------------------------------------------
          # Network utilities used by the original add-on
          # --------------------------------------------------------

          RUN apt-get update \
              && apt-get install -y \
                  --no-install-recommends \
                  iputils-ping \
                  iproute2 \
                  net-tools \
                  ca-certificates \
              && rm -rf /var/lib/apt/lists/*


          # --------------------------------------------------------
          # Production dependencies
          # --------------------------------------------------------

          COPY server/package*.json ./

          RUN npm install \
                  --omit=dev \
                  --ignore-scripts \
                  --no-audit \
                  --no-fund \
              && npm cache clean --force


          # --------------------------------------------------------
          # Compiled server + frontend
          # --------------------------------------------------------

          COPY --from=build /build/server/dist ./
          COPY --from=build /build/web/dist ./public

          COPY version ./version


          # --------------------------------------------------------
          # eWeLink Smart Home add-on port
          # --------------------------------------------------------

          EXPOSE 8321


          # --------------------------------------------------------
          # Start server
          # --------------------------------------------------------

          CMD ["node", "index.js"]
          DOCKERFILE

          echo "Dockerfile.candidate created:"
          cat source/Dockerfile.candidate


      # ============================================================
      # NODE / TESTS
      # ============================================================

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"


      - name: Install test dependencies
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail

          npm install \
            --prefix server \
            --ignore-scripts \
            --no-audit \
            --no-fund

          npm install \
            --prefix server \
            --no-save \
            --ignore-scripts \
            @types/ws@7


      - name: Run reconnect and OAuth tests
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail

          node --test \
            tests/reconnect.cjs \
            tests/oauth.cjs \
            tests/token-refresh.cjs


      - name: TypeScript check
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail

          server/node_modules/.bin/tsc \
            --noEmit \
            -p server/tsconfig.json


      # ============================================================
      # ARMv7 EMULATION
      # ============================================================

      - name: Setup QEMU
        uses: docker/setup-qemu-action@v3
        with:
          platforms: arm


      - name: Setup Docker Buildx
        uses: docker/setup-buildx-action@v3


      # ============================================================
      # GHCR LOGIN
      # ============================================================

      - name: Login to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}


      # ============================================================
      # IMAGE NAME
      #
      # Docker/GHCR image names must be lowercase.
      # ============================================================

      - name: Set image name
        shell: bash
        run: |
          set -euo pipefail

          OWNER="${GITHUB_REPOSITORY_OWNER,,}"

          echo "IMAGE=ghcr.io/${OWNER}/${IMAGE_NAME}" >> "$GITHUB_ENV"

          echo "Image:"
          echo "ghcr.io/${OWNER}/${IMAGE_NAME}"


      # ============================================================
      # BUILD + PUSH
      #
      # IMPORTANT FOR iHOST:
      #
      # platforms:
      #   linux/arm/v7
      #
      # provenance: false
      # sbom: false
      #
      # oci-mediatypes=false
      #
      # This avoids additional OCI/attestation manifests that
      # can confuse older Docker implementations.
      # ============================================================

      - name: Build and push iHost ARMv7 image
        uses: docker/build-push-action@v6
        with:
          context: ./source
          file: ./source/Dockerfile.candidate

          platforms: linux/arm/v7

          provenance: false
          sbom: false

          outputs: type=image,push=true,oci-mediatypes=false

          tags: |
            ${{ env.IMAGE }}:latest
            ${{ env.IMAGE }}:compat
            ${{ env.IMAGE }}:${{ github.sha }}


      # ============================================================
      # VERIFY IMAGE
      # ============================================================

      - name: Verify published image
        shell: bash
        run: |
          set -euo pipefail

          echo
          echo "================================================"
          echo "Checking:"
          echo "${IMAGE}:latest"
          echo "================================================"
          echo

          docker buildx imagetools inspect "${IMAGE}:latest"

          echo
          echo "Checking required iHost architecture..."
          echo

          INSPECT="$(docker buildx imagetools inspect "${IMAGE}:latest")"

          if echo "$INSPECT" | grep -q "linux/arm/v7"; then

            echo "✅ linux/arm/v7 found"

          else

            echo "❌ ERROR"
            echo "linux/arm/v7 was not found in the published image."
            echo
            echo "iHost will not recognize this image correctly."

            exit 1

          fi


      # ============================================================
      # RAW MANIFEST INFORMATION
      # ============================================================

      - name: Inspect raw Docker manifest
        shell: bash
        run: |
          set -euo pipefail

          echo
          echo "================================================"
          echo "RAW IMAGE MANIFEST"
          echo "================================================"
          echo

          docker buildx imagetools inspect \
            "${IMAGE}:latest" \
            --raw


      # ============================================================
      # FINAL RESULT
      # ============================================================

      - name: Build summary
        shell: bash
        run: |
          echo
          echo "================================================"
          echo "       iHost Reconnect image ready"
          echo "================================================"
          echo
          echo "IMAGE:"
          echo "${IMAGE}:latest"
          echo
          echo "ARCHITECTURE:"
          echo "linux/arm/v7"
          echo
          echo "PORT:"
          echo "8321"
          echo
          echo "RECOMMENDED iHOST NETWORK MODE:"
          echo "host"
          echo
          echo "TAGS:"
          echo "${IMAGE}:latest"
          echo "${IMAGE}:compat"
          echo "${IMAGE}:${GITHUB_SHA}"
          echo
          echo "================================================"
