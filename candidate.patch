+import axios from 'axios';
+import { apiOrigin, sign } from './router';
+import type IEWeLinkApiInfo from '../ts/interface/IEWeLinkApiInfo';
+
+export function ownApiKey(families: any[], things: any[]): string {
+    // Shared devices/families belong to another account; never use their key.
+    const keys = new Set<string>();
+    for (const family of families) if (family.familyType === 1 && typeof family.apikey === 'string' && family.apikey) keys.add(family.apikey);
+    for (const thing of things) if (thing.itemType === 1 && typeof thing.itemData?.apikey === 'string' && thing.itemData.apikey) keys.add(thing.itemData.apikey);
+    if (keys.size !== 1) throw new Error('Cannot identify account owner');
+    return [...keys][0];
+}
+export async function exchangeAccount(appId: string, secret: string, redirectUrl: string, code: string, region: string): Promise<IEWeLinkApiInfo> {
+    const http = axios.create({ baseURL: apiOrigin(region), timeout: 10000, maxRedirects: 0, maxContentLength: 5 * 1024 * 1024 });
+    const body = JSON.stringify({ code, redirectUrl, grantType: 'authorization_code' });
+    const token = (await http.post('/v2/user/oauth/token', body, { headers: { 'Content-Type': 'application/json', 'X-CK-Appid': appId, Authorization: `Sign ${sign(secret, body)}` } })).data;
+    const data = token?.data;
+    if (token.error !== 0 || typeof data?.accessToken !== 'string' || !data.accessToken || typeof data?.refreshToken !== 'string' || !data.refreshToken || !Number.isFinite(data.atExpiredTime) || data.atExpiredTime <= Date.now()) throw new Error('Invalid token response');
+    const headers = { 'X-CK-Appid': appId, Authorization: `Bearer ${data.accessToken}` };
+    const get = async (path: string, params = {}) => {
+        await new Promise(resolve => setTimeout(resolve, 1000));
+        const response = (await http.get(path, { headers, params })).data;
+        if (response.error !== 0) throw new Error('Account access denied');
+        return response.data;
+    };
+    const familyData = await get('/v2/family');
+    if (!Array.isArray(familyData?.familyList)) throw new Error('Invalid family list');
+    const things: any[] = [];
+    for (const family of familyData.familyList) {
+        let beginIndex = -9999999;
+        for (let page = 0; ; page++) {
+            if (page >= 100) throw new Error('Device list exceeds supported size');
+            const response = await get('/v2/device/thing', { familyid: family.id, num: 30, beginIndex });
+            if (!Array.isArray(response?.thingList)) throw new Error('Invalid device list');
+            const batch = response.thingList;
+            things.push(...batch);
+            if (batch.length < 30) break;
+            const lastIndex = batch[batch.length - 1].index;
+            if (!Number.isFinite(lastIndex) || lastIndex <= beginIndex) throw new Error('Invalid device pagination');
+            beginIndex = lastIndex + 1;
+        }
+    }
+    const required = process.env.EWELINK_REQUIRED_DEVICE_ID;
+    if (required && !things.some(t => [1, 2].includes(t.itemType) && t.itemData?.deviceid === required)) throw new Error('Required device is not authorised');
+    return { at: data.accessToken, rt: data.refreshToken, region: region as IEWeLinkApiInfo['region'], authMode: 'oauth', atExpiredTime: data.atExpiredTime,
+        userInfo: { account: 'eWeLink OAuth', autoSyncStatus: false }, user: { apikey: ownApiKey(familyData.familyList, things), accountLevel: 0 } };
+}
