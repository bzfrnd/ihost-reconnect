+import axios from 'axios';
+import config from '../../config';
+import logger from '../../log';
+import db from '../../utils/db';
+import { apiOrigin } from '../../oauth/router';
+import { initCoolkitApi } from '../../utils/initApi';
+import WebSocketService from '../../lib/coolkit-ws/dist/class/WebSocket';
+
+let refreshing = false;
+export default async function refreshEWeLinkToken() {
+    const account = db.getDbValue('eWeLinkApiInfo');
+    const updated = db.getDbValue('atUpdateTime');
+    if (!account || !updated || refreshing) return;
+    const expiry = account.atExpiredTime || updated + 30 * 86400000;
+    if (Date.now() < Math.min(expiry - 86400000, updated + 15 * 86400000)) return;
+    const previousToken = account.at;
+    refreshing = true;
+    try {
+        const response = await axios.post(`${apiOrigin(account.region)}/v2/user/refresh`, { rt: account.rt }, {
+            timeout: 10000, maxRedirects: 0,
+            headers: { 'X-CK-Appid': config.coolKit.appId, Authorization: `Bearer ${previousToken}` },
+        });
+        const { error, data } = response.data;
+        if (error !== 0 || typeof data?.at !== 'string' || !data.at || typeof data?.rt !== 'string' || !data.rt) {
+            logger.warn('Token refresh rejected; session retained for retry. Reauthorise if this persists.');
+            return;
+        }
+        // A response from an old session must never restore a logged-out account.
+        const current = db.getDbValue('eWeLinkApiInfo');
+        if (!current || current.at !== previousToken || current.user.apikey !== account.user.apikey) return;
+        db.setDbValue('eWeLinkApiInfo', { ...current, at: data.at, rt: data.rt, atExpiredTime: Date.now() + 30 * 86400000 });
+        db.setDbValue('atUpdateTime', Date.now());
+        initCoolkitApi();
+        // Keep the established socket; future handshakes use the fresh token.
+        if (WebSocketService.connectConfig?.apikey === current.user.apikey && 'at' in WebSocketService.connectConfig) WebSocketService.connectConfig.at = data.at;
+        logger.info('eWeLink token refreshed');
+    } catch (_) {
+        // Network outages must not log the user out or write credentials to logs.
+        logger.warn('eWeLink token refresh unavailable; retry scheduled');
+    } finally {
+        refreshing = false;
+    }
+}
