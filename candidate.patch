diff --git a/server/oauth/router.ts b/server/oauth/router.ts
--- /dev/null
+++ b/server/oauth/router.ts
@@ -0,0 +1,94 @@
+import express, { Request } from 'express';
+import { createHmac, randomBytes, timingSafeEqual } from 'crypto';
+
+export interface OAuthOptions {
+    appId: string;
+    appSecret: string;
+    redirectUrl: string;
+    loggedIn: () => boolean;
+    exchange: (code: string, region: string) => Promise<unknown>;
+    save: (account: any) => void;
+    afterLogin: () => Promise<unknown>;
+    report: (event: string) => void;
+}
+export function sign(secret: string, value: string) {
+    return createHmac('sha256', secret).update(value).digest('base64');
+}
+export function apiOrigin(region: string) {
+    if (!['eu', 'us', 'as', 'cn'].includes(region)) throw new Error('Invalid region');
+    return `https://${region}-apia.coolkit.${region === 'cn' ? 'cn' : 'cc'}`;
+}
+function equal(a: unknown, b: string): boolean {
+    return typeof a === 'string' && Buffer.byteLength(a) === Buffer.byteLength(b) && timingSafeEqual(Buffer.from(a), Buffer.from(b));
+}
+function cookie(req: Request) {
+    return (req.headers.cookie || '').split(';').map(s => s.trim()).find(s => s.startsWith('ewelink_oauth='))?.slice(14) || '';
+}
+export function createOAuthRouter(options: OAuthOptions) {
+    const router = express.Router();
+    const pending = new Map<string, { expires: number; state: string; started: boolean }>();
+    let callback: URL | undefined;
+    try {
+        const url = new URL(options.redirectUrl);
+        if (['http:', 'https:'].includes(url.protocol) && !url.username && !url.password && !url.search && !url.hash && url.pathname === '/oauth/callback') callback = url;
+    } catch (_) { /* Remain disabled until configured. */ }
+    const enabled = !!(callback && options.appId && options.appSecret);
+    const cookieOptions = { httpOnly: true, sameSite: 'lax' as const, secure: callback?.protocol === 'https:', path: '/oauth' };
+    const page = (body: string) => `<!doctype html><html lang="hu"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>iHost – eWeLink</title><body><h1>eWeLink-belépés</h1>${body}</body></html>`;
+    router.use((_req, res, next) => {
+        res.set({ 'Cache-Control': 'no-store', 'Referrer-Policy': 'no-referrer', 'X-Frame-Options': 'DENY', 'Content-Security-Policy': "default-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" });
+        next();
+    });
+    router.get('/status', (_req, res) => { res.json({ enabled }); });
+    router.use((req, res, next) => {
+        if (!enabled) return res.status(503).send(page('<p>Az App ID, App Secret és Redirect URL még nincs beállítva a konténerben.</p>'));
+        // Only the explicitly configured address may receive the browser session.
+        if (req.get('host') !== callback!.host) return res.redirect(303, `${callback!.origin}/oauth`);
+        next();
+    });
+    router.get('/', (req, res) => {
+        if (options.loggedIn()) return res.status(409).send(page('<p>Már be vagy jelentkezve. Fiókváltás előtt jelentkezz ki a kiegészítőben.</p>'));
+        for (const [id, session] of pending) if (session.expires <= Date.now()) pending.delete(id);
+        if (pending.size >= 100) return res.status(429).send(page('<p>Túl sok belépési kísérlet. Próbáld újra később.</p>'));
+        pending.delete(cookie(req));
+        const id = randomBytes(32).toString('hex');
+        const state = randomBytes(32).toString('hex');
+        pending.set(id, { state, started: false, expires: Date.now() + 10 * 60 * 1000 });
+        res.cookie('ewelink_oauth', id, { ...cookieOptions, maxAge: 10 * 60 * 1000 });
+        res.send(page(`<p>A folytatás az eWeLink hivatalos bejelentkezési oldalára visz.</p><form method="post" action="/oauth/start"><input type="hidden" name="state" value="${state}"><button type="submit">Folytatás az eWeLink oldalán</button></form>`));
+    });
+    router.post('/start', express.urlencoded({ extended: false, limit: '2kb' }), (req, res) => {
+        const session = pending.get(cookie(req));
+        if (req.get('origin') !== callback!.origin || !session || session.started || session.expires <= Date.now() || !equal(req.body.state, session.state)) {
+            return res.status(400).send(page('<p>Érvénytelen belépési kísérlet. Nyisd meg újra a belépési oldalt.</p>'));
+        }
+        session.started = true;
+        const seq = String(Date.now());
+        const url = new URL('https://c2ccdn.coolkit.cc/oauth/index.html');
+        url.search = new URLSearchParams({ clientId: options.appId, seq, authorization: sign(options.appSecret, `${options.appId}_${seq}`), redirectUrl: options.redirectUrl, grantType: 'authorization_code', state: session.state, nonce: randomBytes(4).toString('hex') }).toString();
+        res.redirect(303, url.toString());
+    });
+    router.get('/callback', async (req, res) => {
+        const id = cookie(req);
+        const session = pending.get(id);
+        if (!session || !session.started || session.expires <= Date.now() || !equal(req.query.state, session.state) || typeof req.query.code !== 'string' || req.query.code.length > 1024 || !req.query.code || typeof req.query.region !== 'string' || !['eu', 'as', 'us', 'cn'].includes(req.query.region)) {
+            return res.status(400).send(page('<p>Érvénytelen vagy lejárt belépés. <a href="/oauth">Újrapróbálás</a></p>'));
+        }
+        pending.delete(id); // Consume before any network request: callback cannot be replayed.
+        res.clearCookie('ewelink_oauth', cookieOptions);
+        if (options.loggedIn()) return res.status(409).send(page('<p>Már be vagy jelentkezve.</p>'));
+        try {
+            const account = await options.exchange(req.query.code, req.query.region);
+            if (options.loggedIn()) return res.status(409).send(page('<p>Közben már megtörtént a belépés.</p>'));
+            options.save(account);
+            options.report('OAuth login succeeded');
+            // Do not hold the callback open for device synchronisation.
+            void options.afterLogin().catch(() => options.report('OAuth device synchronisation failed; retry from the add-on'));
+            return res.redirect(303, '/#/home');
+        } catch (_) {
+            options.report('OAuth login failed (exchange or account validation)');
+            return res.status(502).send(page('<p>A belépést vagy az eszközhozzáférést nem sikerült ellenőrizni. Ellenőrizd az app beállításait és jogosultságait. <a href="/oauth">Újrapróbálás</a></p>'));
+        }
+    });
+    return router;
+}
