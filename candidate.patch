+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+const {EventEmitter} = require('node:events');
+const {stripTypeScriptTypes} = require('node:module');
+const root = path.join(__dirname, '..');
+const enums = require('../server/lib/coolkit-ws/dist/ts/enum.js');
+function loadTS(file, globals) {
+ let source = fs.readFileSync(path.join(root,file),'utf8').replace(/^import .*;\r?$/gm,'');
+ source=stripTypeScriptTypes(source,{mode:'strip'}).replace('export default class','module.exports = class').replace('export default new WsReconnectClass();','module.exports = new WsReconnectClass();');
+ const context={module:{exports:{}},console:{log(){},error(){}},...globals};
+ vm.runInNewContext(source,context);
+ return context.module.exports;
+}
+function sdk(compiled=false){
+ const ee=new EventEmitter(), delays=[], events=[];
+ const emit=ee.emit.bind(ee);
+ ee.emit=(name,...args)=>{if(name==='reconnect')events.push(args[0]);return emit(name,...args);};
+ const helpers={sleep:async n=>delays.push(n)};
+ let WS;
+ if(compiled){
+  const context={exports:{},console:{log(){},error(){}},clearInterval,require(name){
+   if(name.includes('tools'))return helpers;
+   if(name.includes('eventEmitter'))return ee;
+   if(name.includes('enum'))return enums;
+   return function(){};
+  }};
+  vm.runInNewContext(fs.readFileSync(path.join(root,'server/lib/coolkit-ws/dist/class/WebSocket.js'),'utf8'),context);
+  WS=context.exports.default;
+ }else WS=loadTS('server/lib/coolkit-ws/src/class/WebSocket.ts',{EE:ee,...enums,...helpers,clearInterval});
+ return {WS,delays,events};
+}
+for(const compiled of [false,true]){
+ test(`${compiled?'distributed JS':'TS source'} recovers after 99 failures`,async()=>{
+  const {WS,delays}=sdk(compiled);
+  const ws=new WS({maxRetry:99,autoReconnect:true,maxRetryInterval:600});
+  let attempts=0;
+  ws._initWs=async()=>{if(++attempts<=130){ws.wsState='CLOSED';return {error:605};} WS.isOpen=true; WS.isReconnecting=false; ws.wsState='CONNECTED'; return {error:0};};
